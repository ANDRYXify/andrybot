# Il dominio (o sottodominio di regione) che il pubblico vede. Il suo DNS deve
# puntare all'IP DI QUESTO server edge.
#   es. eu.socialbot.live   (un edge europeo)
#       us.socialbot.live   (un edge negli Stati Uniti)
EDGE_DOMAIN=eu.socialbot.live

# Dove sta l'origine vera (il server col bot). Un indirizzo NON pubblicizzato
# nel DNS del dominio principale: è il segreto che l'edge protegge.
ORIGIN=https://origine.esempio.net
# Il nome con cui l'origine si aspetta di essere chiamata (per il certificato).
ORIGIN_HOST=socialbot.live

# La chiave dell'edge: DEVE essere identica a EDGE_KEY sul server origine.
# Generala a caso e lunga, es.:  openssl rand -hex 32
EDGE_KEY=metti-qui-la-stessa-chiave-del-server-origine
