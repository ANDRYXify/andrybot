# segreti e dati locali: MAI su GitHub
# data/ contiene anche gli effetti caricati (data/effects/<login>/) e i
# file temporanei di upload (data/tmp/): roba locale, mai versionata.
.env
data/
node_modules/
*.log
# cache di Python (creata validando gli esempi in docs/esempi-webhook/)
__pycache__/
*.pyc
# chiavi SSH generate dagli script
server/pc/chiavi/

# tracce private: NON vanno su GitHub (il repository e' pubblico). Vivono nel
# repository privato del cervello. Il cancello scripts/verifica-riservati.mjs
# impedisce che ne rientri una per sbaglio.

# la licenza del server e QUALUNQUE chiave privata: non entrano mai in git
licenza.txt
*.pem
.socialbot-chiave-privata.pem

# roba che macOS semina in ogni cartella
.DS_Store
**/.DS_Store
