# ============================================================
#  SocialBot — configurazione Caddy
#
#  HTTPS AUTOMATICO: Caddy ottiene e rinnova DA SOLO i certificati
#  Let's Encrypt per OGNI dominio elencato qui. Requisiti per ciascuno:
#    1. il DNS del dominio deve puntare a questo server (record A/AAAA);
#    2. le porte 80 e 443 devono essere raggiungibili da internet.
#  Se un dominio non è ancora puntato, Caddy riprova in background per
#  QUEL dominio soltanto: gli altri continuano a funzionare.
#
#  MIGRAZIONE a socialbot.live (dominio ufficiale) — COMPLETATA:
#   - socialbot.live serve l'app; www → nudo; socialbot.it/www → .live (301).
#   - bot.andryxify.it NON è più su questo server: il suo DNS è stato
#     spostato su Squarespace, che già reindirizza a socialbot.live. Per
#     questo qui NON c'è più un suo blocco (Caddy tenterebbe invano di
#     ottenere un certificato per un dominio che non controlliamo più).
#
#   NOTA SEO (da sistemare su Squarespace/IONOS, non qui): oggi
#   bot.andryxify.it fa un 302 verso http://socialbot.live SENZA path.
#   Meglio un 301 verso https://socialbot.live che preservi il path, così
#   i vecchi link/overlay non si rompono e la SEO si consolida. Poi, se
#   serve, "Change of address" in Google Search Console.
# ============================================================

# --- Opzioni globali: robustezza sotto carico ----------------
# Solo cose SICURE che non toccano gli upload né gli overlay in tempo reale:
#  · read_header 10s → il classico "slowloris" manda gli header a goccia per
#    tenere aperte migliaia di connessioni e affogare il server. Un client vero
#    li manda in millisecondi: chi ci mette più di 10 secondi viene chiuso. NON
#    tocca il corpo (gli upload di video restano liberi) né le risposte lunghe
#    (overlay, chat: quelle restano aperte quanto serve).
#  · max_header_size 32KB → header giganti (un altro modo di sprecarci memoria)
#    vengono rifiutati subito.
{
	servers {
		timeouts {
			read_header 10s
		}
		max_header_size 32KB
	}
}

# --- Header di sicurezza COMUNI a ogni risposta --------------
# Snippet riusato dai vari gruppi qui sotto: quello che è UGUALE ovunque sta
# qui una volta sola; la CSP e l'anti-frame cambiano per gruppo (vedi sotto),
# perché alcune NOSTRE pagine hanno bisogno di sorgenti esterne precise.
(sicurezza_comune) {
	# HSTS: forza HTTPS per un anno, sottodomini inclusi (solo www, già su HTTPS).
	# 'preload' NON incluso: è un impegno formale (lista dei browser) — attivalo
	# tu quando sei certo, aggiungendo "; preload" e iscrivendoti su hstspreload.org
	Strict-Transport-Security "max-age=31536000; includeSubDomains"
	# niente MIME-sniffing
	X-Content-Type-Options "nosniff"
	# referrer prudente
	Referrer-Policy "strict-origin-when-cross-origin"
	# COOP: isola la pagina dai popup/finestre cross-origin (niente window.opener
	# condiviso) → difesa in più contro leak cross-origin e attacchi tipo Spectre.
	# "allow-popups" NON rompe eventuali finestre OAuth/pagamento che apriamo noi.
	# NB: NON attivo COEP (require-corp): romperebbe gli embed e i CDN esterni che
	# ci servono davvero (player, 7TV, librerie ML, immagini profilo…).
	Cross-Origin-Opener-Policy "same-origin-allow-popups"
	# limita API del browser che non servono. NB: NON blocco camera/microphone
	# perché il tracking e la voce usano webcam/microfono nel Browser Source.
	Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=(), usb=(), magnetometer=()"
	# togli l'header che rivela il server (coerente col "labirinto")
	-Server
}

# --- Dominio UFFICIALE: serve l'app -------------------------
# Perché più blocchi `handle` invece di un solo `header` di sito? La CSP deve
# cambiare per POCHE pagine nostre che caricano sorgenti esterne fidate:
#  · /tgapp  → la Mini App gira DENTRO Telegram (script telegram.org + iframe
#              di Telegram Web): CSP dedicata, niente X-Frame-Options.
#  · /voce.html e /tracking/* → riconoscimento vocale e webcam sul dispositivo
#              (transformers.js/Human da jsdelivr, modelli HuggingFace/GitHub,
#              WASM + worker): serve allargare script/connect SOLO qui.
#  · tutto il resto (dashboard, overlay, vetrina, 404 del labirinto) → CSP
#              stretta e X-Frame-Options DENY, come prima.
# Ogni `handle` è esclusivo (vince il primo che combacia): così ogni risposta
# riceve UN SOLO set di header, senza ambiguità di precedenza.
socialbot.live {
	encode gzip

	@tgapp path /tgapp /tgapp.html
	@ml path /voce.html /tracking/*

	# --- Mini App Telegram: script SDK + framing di Telegram Web -----------
	handle @tgapp {
		header {
			import sicurezza_comune
			# NIENTE X-Frame-Options: la Mini App è incorniciata da Telegram Web.
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://telegram.org; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self'; frame-ancestors https://web.telegram.org https://*.telegram.org; base-uri 'self'; object-src 'none'"
		}
		reverse_proxy bot:8090 {
			header_up X-Edge-Key {env.EDGE_KEY}
		}
	}

	# --- Voce (Whisper) e tracking (Human): ML sul dispositivo ------------
	# Sono pagine NOSTRE che girano top-level (OBS/scheda): resta X-Frame DENY.
	# Allarghiamo SOLO script/connect/worker verso i CDN dei modelli e il WASM.
	handle @ml {
		header {
			import sicurezza_comune
			X-Frame-Options "DENY"
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://cdn.jsdelivr.net https://vladmandic.github.io https://huggingface.co https://*.hf.co https://cdn-lfs.huggingface.co https://cdn-lfs-us-1.hf.co; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		}
		reverse_proxy bot:8090 {
			header_up X-Edge-Key {env.EDGE_KEY}
		}
	}

	# --- Tutto il resto: CSP stretta, anti-clickjacking pieno ------------
	handle {
		header {
			import sicurezza_comune
			# anti-clickjacking: la dashboard non va incorniciata da altri siti.
			# (frame-ancestors nella CSP fa lo stesso, ma questo copre browser vecchi)
			X-Frame-Options "DENY"
			# CSP: SPA con script inline + font Google + 7TV + media utente + canvas.
			# 'unsafe-inline' è un compromesso per non rompere la dashboard.
			# frame-src https:  → le PAGINE LINK (/u/*) e l'anteprima dell'editor
			#   incorporano contenuti scelti dall'utente (YouTube, Spotify, Twitch,
			#   TikTok, Vimeo, una pagina qualsiasi…): senza, la CSP li bloccava tutti
			#   (frame-src ereditava da default-src 'self'). NON allenta l'anti-
			#   clickjacking: quello è frame-ancestors 'none' + X-Frame-Options DENY,
			#   che restano — questo dice solo COSA possiamo incorniciare NOI.
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self'; frame-src https:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		}
		reverse_proxy bot:8090 {
			header_up X-Edge-Key {env.EDGE_KEY}
		}
	}
}

# www → dominio nudo (canonico)
www.socialbot.live {
	redir https://socialbot.live{uri} permanent
}

# --- .it → .live (301 permanente, buono per la SEO) ---------
socialbot.it, www.socialbot.it {
	redir https://socialbot.live{uri} permanent
}

# --- Vecchio dominio bot.andryxify.it: NON più qui ----------
# Il suo DNS è stato spostato su Squarespace, che già reindirizza a
# socialbot.live. Niente blocco Caddy: se un domani il DNS tornasse a
# puntare a questo server, ripristina:
#   bot.andryxify.it {
#       redir https://socialbot.live{uri} permanent
#   }
